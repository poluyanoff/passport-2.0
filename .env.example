# Пока используется локальный детерминированный проверяющий модуль.
AI_PROVIDER=mock

# Чтобы включить реальную AI-проверку, замените mock на openai.
# AI_PROVIDER=openai
# OPENAI_MODEL=gpt-4.1-mini
# Не добавляйте ключ в Git и не передавайте его в браузер.
# OPENAI_API_KEY=

# Ограничение проверок с одного IP-адреса для одного экземпляра сервера.
REVIEW_RATE_LIMIT_MAX=20
REVIEW_RATE_LIMIT_WINDOW_MS=60000
